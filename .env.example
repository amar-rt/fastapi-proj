# Neon Postgres (Vercel Marketplace -> Neon, free). Use the POOLED connection string.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Long random string used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string

# LLM + speech-to-text: any OpenAI-compatible endpoint.
# Free default: Groq (https://console.groq.com) running OpenAI's open-weight models.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_groq_key
LLM_MODEL_MAIN=openai/gpt-oss-120b
LLM_MODEL_FAST=openai/gpt-oss-20b
STT_MODEL=whisper-large-v3-turbo
# To switch to paid OpenAI later: LLM_BASE_URL=https://api.openai.com/v1, models gpt-4o-mini / whisper-1
